{
  "name": "@yep-anywhere/client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/run-with-safe-home.js vite",
    "dev:remote": "node ../../scripts/run-with-safe-home.js vite --config vite.config.remote.ts",
    "build": "tsc && vite build",
    "build:stable": "tsc && vite build --base /_stable/ --outDir dist-stable",
    "build:remote": "tsc && vite build --config vite.config.remote.ts",
    "preview:remote": "vite preview --config vite.config.remote.ts"
  },
  "dependencies": {
    "@yep-anywhere/shared": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.11.0",
    "tssrp6a": "^3.0.0",
    "tweetnacl": "^1.0.3",
    "uqr": "^0.1.2",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@types/hast": "^3.0.4",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
